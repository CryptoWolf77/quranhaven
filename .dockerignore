# An allowlist keeps local account data, credentials and build caches out.
*
!Dockerfile
!pubspec.yaml
!pubspec.lock
!.metadata
!l10n.yaml
!analysis_options.yaml
!lib/
!lib/**
!web/
!web/**
!vendor/
!vendor/**
!content/
!content/prepare_content.py
!content/public/
!content/public/**
!deployment/
!deployment/nginx.conf
!deployment/prepare_offline.py
**/.git
**/.dart_tool
**/build
**/.gradle
**/.env
**/.env.*
**/local.properties
**/key.properties
**/*.jks
**/*.keystore
**/*.pem
**/*.p12
**/*.pfx
**/*.part*
**/__pycache__
